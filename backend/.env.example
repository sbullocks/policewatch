# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Neon Postgres — from neon.tech project dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 — from R2 > Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=policewatch-videos
# Public URL — from R2 bucket > Settings > Public Access domain
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Admin review page password
ADMIN_PASSWORD=change_this_in_production
